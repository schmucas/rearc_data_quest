{
  "datasets": [
    {
      "name": "ds_population_stats",
      "displayName": "Population stats",
      "queryLines": [
        "SELECT year_count, population_mean, population_stddev_samp, population_stddev_pop FROM population_stats"
      ]
    },
    {
      "name": "ds_best_year_per_series",
      "displayName": "Agg value per year",
      "queryLines": [
        "SELECT series_id, \n",
        "       sector_name, \n",
        "       measure_text, \n",
        "       label, \n",
        "       year, \n",
        "       summed_value,\n",
        "       population \n",
        "FROM agg_value_per_year \n",
        "WHERE (case when :series_id = 'All' then TRUE else series_id = :series_id end)  \n",
        "and (case when :sector = 'All' then TRUE else sector_name = :sector end)\n",
        "and (case when :measure = 'All' then TRUE else measure_text = :measure end)\n",
        "ORDER BY summed_value DESC"
      ],
      "parameters": [
        {
          "displayName": "series_id",
          "keyword": "series_id",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        },
        {
          "displayName": "sector",
          "keyword": "sector",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        },
        {
          "displayName": "measure",
          "keyword": "measure",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_series_count",
      "displayName": "best year series",
      "queryLines": [
        "SELECT case when :series_id = 'All' then 0 else max(year) end best_year,\n",
        "    case when :series_id = 'All' then 0 else max(summed_value) end best_year_value\n",
        "from agg_value_per_year\n",
        "where (case when :series_id = 'All' then TRUE else series_id = :series_id end)\n",
        "and is_best_year = true"
      ],
      "parameters": [
        {
          "displayName": "series_id",
          "keyword": "series_id",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_series_year_history",
      "displayName": "Every year's total, per series",
      "queryLines": [
        "SELECT series_id, sector_name, measure_text, year, summed_value FROM agg_value_per_year ORDER BY year"
      ]
    },
    {
      "name": "0530d607",
      "displayName": "value per quarter",
      "queryLines": [
        "SELECT series_id, \n",
        "       sector_name, \n",
        "       measure_text, \n",
        "       label, \n",
        "       year, \n",
        "       value,\n",
        "       population,\n",
        "       period \n",
        "FROM value_per_quarter \n",
        "WHERE (case when :series_id = 'All' then TRUE else series_id = :series_id end)  \n",
        "and period = :quarter\n",
        "ORDER BY value DESC"
      ],
      "parameters": [
        {
          "displayName": "series_id",
          "keyword": "series_id",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        },
        {
          "displayName": "quarter",
          "keyword": "quarter",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Q01"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "f335b19c",
      "displayName": "Quarters",
      "queryLines": [
        "select distinct period\n",
        "from value_per_quarter"
      ]
    },
    {
      "name": "9a01aee7",
      "displayName": "best quarter series",
      "queryLines": [
        "SELECT case when :series_id = 'All' then 0 else max(year) end best_year,\n",
        "    case when :series_id = 'All' then 0 else max(value) end best_year_value\n",
        "from value_per_quarter\n",
        "where (case when :series_id = 'All' then TRUE else series_id = :series_id end)\n",
        "and period = :quarter\n",
        "and best_year_per_quarter = true"
      ],
      "parameters": [
        {
          "displayName": "series_id",
          "keyword": "series_id",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        },
        {
          "displayName": "quarter",
          "keyword": "quarter",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Q01"
                }
              ]
            }
          }
        }
      ]
    }
  ],
